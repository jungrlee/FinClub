# ---- Anthropic (required for AI forecasts) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- US market data: Finnhub (required) ----
# Free key, no card: https://finnhub.io  (60 calls/min)
FINNHUB_API_KEY=

# ---- Korean market data: KIS OpenAPI (optional) ----
# https://apiportal.koreainvestment.com  — needs a KIS brokerage account,
# approval takes 1-2 days. Until then KR falls back to Yahoo automatically.
KIS_APP_KEY=
KIS_APP_SECRET=

# Set to 1 to use the 모의투자 (paper) endpoint instead of production
KIS_MOCK=

# ---- Admin console (admin.finclub.app) ----
# Same Supabase project as above, but the service_role key — server-only,
# NEVER prefix with NEXT_PUBLIC_, bypasses RLS entirely. From Supabase
# Dashboard → Project Settings → API → service_role secret.
# Used only by lib/adminSupabase.js, gated behind lib/requireAdmin.js's
# `admins` table check — never reachable by an unauthenticated request.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
